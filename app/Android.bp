package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "Strand",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    required: ["privapp_whitelist_org.strand.engine"],
    optimize: {
        enabled: false,
    },
}

prebuilt_etc {
    name: "privapp_whitelist_org.strand.engine",
    src: "privapp_whitelist_org.strand.engine.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
