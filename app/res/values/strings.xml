    <string name="health_trim_desc">Tells the flash which blocks are free (fstrim), which keeps writes fast.</string>
    <string name="health_gc">Defragment storage</string>
    <string name="health_gc_desc">Runs the flash file system\'s garbage collection, which merges half-used blocks. Storage that has been in use for weeks gets fast again. Also runs by itself while the device is idle.</string>
