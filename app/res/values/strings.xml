    <string name="hero_quiet">Staying out of the way: game or heavy GPU work in front</string>
    <string name="autogame_desc">Games get the Gaming profile, and Strand stays out of their way: no memory compaction or maintenance until they close. Heavy GPU work in any app gets the same quiet system.</string>
    <string name="health_cache">Clear app caches</string>
    <string name="health_cache_desc">Deletes cached files of all apps. Apps rebuild them as needed; nothing you saved is touched.</string>
    <string name="health_cache_confirm">Clear the caches of all apps?</string>
    <string name="health_auto">Weekly maintenance</string>
    <string name="health_auto_desc">Storage GC daily while idle; trim, GC and app optimization weekly while idle and charging. Stops the moment you pick the device up.</string>
