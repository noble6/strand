package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_defaults {
    name: "strand_defaults",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    cpp_std: "c++17",
    apex_available: [
        "//apex_available:platform",
        "org.strand.engine",
    ],
    min_sdk_version: "34",
}

cc_binary {
    name: "strandd",
    defaults: ["strand_defaults"],
    srcs: [
        "actions.cpp",
        "config.cpp",
        "engine.cpp",
        "main.cpp",
        "util.cpp",
    ],
    shared_libs: ["liblog"],
    init_rc: ["strandd.rc"],
}

cc_binary {
    name: "strandctl",
    defaults: ["strand_defaults"],
    srcs: ["strandctl.cpp"],
}

// /data/misc/strand must exist before the daemon starts; APEX init scripts
// are read too late for post-fs-data, so this one lives on system_ext.
prebuilt_etc {
    name: "strand-data.rc",
    src: "strand-data.rc",
    sub_dir: "init",
    system_ext_specific: true,
}
